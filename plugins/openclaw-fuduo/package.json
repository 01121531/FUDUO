      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.17",
      "minGatewayVersion": "2026.5.17"
    }
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "5.9.3",
    "vitest": "latest"
  }
}
