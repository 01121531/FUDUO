{
  "name": "@fuduo/openclaw-fuduo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "typebox": "1.3.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
